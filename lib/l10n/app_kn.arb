  "tonightPlanets": "ಹುಡುಕಿ: {planets}.",
  "tonightNoPlanets": "ಸಂಜೆಯ ಆಕಾಶದಲ್ಲಿ ಪ್ರಕಾಶಮಾನ ಗ್ರಹಗಳಿಲ್ಲ.",
  "tonightNoCity": "ಗ್ರಹಗಳನ್ನು ನೋಡಲು Heliora ದಲ್ಲಿ ನಗರ ಆರಿಸಿ.",
  "birthdayTitle": "ನನ್ನ ಹುಟ್ಟುಹಬ್ಬದ ಆಕಾಶ",
  "birthdaySubtitle": "ನೀವು ಹುಟ್ಟಿದ ದಿನ ಚಂದ್ರ ಮತ್ತು ಗ್ರಹಗಳು ಎಲ್ಲಿದ್ದವು, ಮತ್ತು ನಿಮ್ಮ ಜೀವನದ ವಿಶೇಷ ದಿನಗಳು.",
  "birthdayCardHint": "ಚಂದ್ರನ ಕಲೆ, ಗ್ರಹಗಳು ಮತ್ತು ಮೈಲಿಗಲ್ಲುಗಳು",
  "birthdayNeedDate": "ನಿಮ್ಮ ಜನ್ಮದಿನಾಂಕ ಹಾಕಿ",
  "birthdayMoon": "ನಿಮ್ಮ ಹುಟ್ಟುಹಬ್ಬದಂದು ಚಂದ್ರ",
  "birthdayPlanets": "ಆ ದಿನ ಗ್ರಹಗಳು",
  "birthdayDaysOld": "ಇಂದು ನಿಮಗೆ {count} ದಿನಗಳಾಗಿವೆ.",
  "birthdayMilestones": "ಮೈಲಿಗಲ್ಲುಗಳು",
  "birthdayDayN": "ದಿನ {count}",
  "birthdayBillion": "100 ಕೋಟಿ ಸೆಕೆಂಡುಗಳ ವಯಸ್ಸು",
  "birthdayPassed": "ಆಯಿತು",
  "birthdayNote": "Heliora ದ ಉಳಿದ ಭಾಗದಂತೆಯೇ ಅದೇ ಕಕ್ಷೆಗಳಿಂದ ನಿಮ್ಮ ಫೋನ್‌ನಲ್ಲೇ ಲೆಕ್ಕ ಹಾಕಲಾಗುತ್ತದೆ. ನಿಮ್ಮ ಜನ್ಮದಿನಾಂಕ ಫೋನ್‌ನಿಂದ ಹೊರಗೆ ಹೋಗುವುದಿಲ್ಲ.",
  "missionsTitle": "ಬಾಹ್ಯಾಕಾಶ ಯಾನಗಳು",
  "missionsSubtitle": "ಬಾಹ್ಯಾಕಾಶ ಅನ್ವೇಷಣೆಯ ಪ್ರಸಿದ್ಧ ಕ್ಷಣಗಳು, ಹಳೆಯದು ಮೊದಲು.",
  "missionsCardHint": "ಕಾಲದಲ್ಲಿ ಪ್ರಸಿದ್ಧ ಯಾನಗಳು",
  "missionSputnik1": "ಮೊದಲ ಕೃತಕ ಉಪಗ್ರಹ. ಬೀಚ್ ಬಾಲ್ ಗಾತ್ರದ ಈ ಲೋಹದ ಚೆಂಡು ಸುಮಾರು ಮೂರು ತಿಂಗಳು ಭೂಮಿಯನ್ನು ಸುತ್ತಿತು. ಅದರ ಬೀಪ್ ಶಬ್ದ ರೇಡಿಯೊದಲ್ಲಿ ಕೇಳಿಸುತ್ತಿತ್ತು, ಮತ್ತು ಇಲ್ಲಿಂದ ಬಾಹ್ಯಾಕಾಶ ಯುಗ ಶುರುವಾಯಿತು.",
  "missionVostok1": "ಯೂರಿ ಗಗಾರಿನ್ ಬಾಹ್ಯಾಕಾಶಕ್ಕೆ ಹೋದ ಮೊದಲ ವ್ಯಕ್ತಿಯಾದರು. ಅವರು ಸುಮಾರು 108 ನಿಮಿಷಗಳಲ್ಲಿ ಭೂಮಿಯನ್ನು ಒಮ್ಮೆ ಸುತ್ತಿದರು.",
  "missionApollo11": "ನೀಲ್ ಆರ್ಮ್‌ಸ್ಟ್ರಾಂಗ್ ಮತ್ತು ಬಜ್ ಆಲ್ಡ್ರಿನ್ ಶಾಂತಿ ಸಾಗರದಲ್ಲಿ ಇಳಿದು ಚಂದ್ರನ ಮೇಲೆ ನಡೆದ ಮೊದಲ ಮನುಷ್ಯರಾದರು. ಮೈಕೇಲ್ ಕಾಲಿನ್ಸ್ ಕಕ್ಷೆಯಲ್ಲಿ ಅವರಿಗಾಗಿ ಕಾದರು.",
  "missionVenera7": "ಬೇರೊಂದು ಗ್ರಹದಲ್ಲಿ ಇಳಿದು ಸಂಕೇತ ಕಳುಹಿಸಿದ ಮೊದಲ ನೌಕೆ. ಶುಕ್ರನ ಜಜ್ಜುವ ಬಿಸಿಯಲ್ಲಿ ಅದು ಸುಮಾರು 23 ನಿಮಿಷ ಮಾಹಿತಿ ಕಳುಹಿಸಿತು.",
  "missionViking1": "ಇದು ಮಂಗಳದಲ್ಲಿ ಇಳಿದು ಆರು ವರ್ಷಗಳಿಗಿಂತ ಹೆಚ್ಚು ಕೆಲಸ ಮಾಡಿತು, ಮತ್ತು ಬೇರೊಂದು ಗ್ರಹದ ನೆಲದಿಂದ ಫೋಟೋ ಹಾಗೂ ಹವಾಮಾನ ವರದಿಗಳ ಮೊದಲ ದೀರ್ಘ ಸರಣಿಯನ್ನು ಕಳುಹಿಸಿತು.",
  "missionVoyager1": "1977 ರಲ್ಲಿ ಉಡಾಯಿಸಲಾಯಿತು, ಗುರು ಮತ್ತು ಶನಿಯ ಬಳಿ ಹಾದು 2012 ರಲ್ಲಿ ನಕ್ಷತ್ರಗಳ ನಡುವಿನ ಬಾಹ್ಯಾಕಾಶ ಪ್ರವೇಶಿಸಿತು. ಭೂಮಿಯಿಂದ ಅತಿ ದೂರದಲ್ಲಿರುವ ಮಾನವ ನಿರ್ಮಿತ ವಸ್ತು ಇದು.",
  "missionHubble": "1990 ರಲ್ಲಿ ಉಡಾಯಿಸಲಾಯಿತು, ಭೂಮಿಯ ಗಾಳಿಯ ಮೇಲಿನಿಂದ ವಿಶ್ವವನ್ನು ನೋಡುತ್ತದೆ. ಇದರ ಸ್ಪಷ್ಟ ಚಿತ್ರಗಳು ವಿಶ್ವದ ವಯಸ್ಸನ್ನು ಅಳೆಯಲು ಸಹಾಯ ಮಾಡಿದವು ಮತ್ತು ಸಾವಿರಾರು ದೂರದ ಗ್ಯಾಲಕ್ಸಿಗಳನ್ನು ತೋರಿಸಿದವು.",
  "missionHuygens": "ಕ್ಯಾಸಿನಿ ಜೊತೆ ಹೋದ ನೌಕೆ ಹೈಜೆನ್ಸ್ ಪ್ಯಾರಾಚೂಟ್‌ನಿಂದ ಶನಿಯ ಚಂದ್ರ ಟೈಟಾನ್‌ನಲ್ಲಿ ಇಳಿಯಿತು. ಹೊರ ಸೌರವ್ಯೂಹದಲ್ಲಿ ಇದು ಮೊದಲ ಇಳಿಯುವಿಕೆ, ಮತ್ತು ಅದು ನೆಲದಿಂದ ಚಿತ್ರಗಳನ್ನು ಕಳುಹಿಸಿತು.",
  "missionCuriosity": "ಕಾರಿನ ಗಾತ್ರದ ಈ ರೋವರ್ ರಾಕೆಟ್ ಚಾಲಿತ ’ಸ್ಕೈ ಕ್ರೇನ್’ ಬಳಸಿ ಗೇಲ್ ಕುಳಿಯಲ್ಲಿ ಇಳಿಯಿತು. ಮಂಗಳದಲ್ಲಿ ಒಮ್ಮೆ ಜೀವಕ್ಕೆ ಸೂಕ್ತ ಪರಿಸ್ಥಿತಿ ಇತ್ತು ಎಂದು ಅದು ಕಂಡುಹಿಡಿಯಿತು.",
  "missionMangalyaan": "ಭಾರತದ ಮಾರ್ಸ್ ಆರ್ಬಿಟರ್ ಮಿಷನ್ ಮೊದಲ ಪ್ರಯತ್ನದಲ್ಲೇ ಮಂಗಳದ ಕಕ್ಷೆ ತಲುಪಿತು. ಯಾವುದೇ ದೇಶಕ್ಕೆ ಇದು ಮೊದಲ ಬಾರಿ, ಮತ್ತು ವೆಚ್ಚವೂ ಬಹಳ ಕಡಿಮೆ.",
  "missionRosetta": "ರೊಸೆಟ್ಟಾದ ಲ್ಯಾಂಡರ್ ಫೈಲಿ ಧೂಮಕೇತು 67P/ಚುರ್ಯುಮೋವ್–ಗೆರಾಸಿಮೆಂಕೊ ಮೇಲೆ ಇಳಿಯಿತು, ಧೂಮಕೇತುವಿನ ಮೇಲೆ ಮೊದಲ ಇಳಿಯುವಿಕೆ. ರೊಸೆಟ್ಟಾ ಎರಡು ವರ್ಷ ಧೂಮಕೇತುವನ್ನು ಸುತ್ತಿತು.",
  "missionNewhorizons": "ಒಂಬತ್ತು ವರ್ಷಗಳ ಪ್ರಯಾಣದ ನಂತರ ಅದು ಪ್ಲೂಟೋ ಬಳಿ ಹಾದು, ಮೊದಲ ಬಾರಿಗೆ ಹಿಮದ ಪರ್ವತಗಳನ್ನು ಮತ್ತು ಹೃದಯಾಕಾರದ ದೊಡ್ಡ ಬಯಲನ್ನು ತೋರಿಸಿತು.",
  "missionPerseverance": "ಪರ್ಸಿವರೆನ್ಸ್ ರೋವರ್ ಹಳೆಯ ಜೀವದ ಕುರುಹುಗಳನ್ನು ಹುಡುಕಲು ಮತ್ತು ಬಂಡೆಗಳ ಮಾದರಿ ಸಂಗ್ರಹಿಸಲು ಜೆಜೆರೊ ಕುಳಿಯಲ್ಲಿ ಇಳಿಯಿತು. ಅದರ ಹೆಲಿಕಾಪ್ಟರ್ ಇಂಜೆನ್ಯುಯಿಟಿ ಬೇರೊಂದು ಗ್ರಹದಲ್ಲಿ ಮೊದಲ ಚಾಲಿತ ಹಾರಾಟ ಮಾಡಿತು.",
  "missionJwst": "ಅತಿ ದೊಡ್ಡ ಬಾಹ್ಯಾಕಾಶ ದೂರದರ್ಶಕಕ್ಕೆ 6.5 ಮೀಟರ್‌ನ ಚಿನ್ನದ ಕನ್ನಡಿ ಇದೆ, ಮತ್ತು ಅದು 15 ಲಕ್ಷ ಕಿಮೀ ದೂರದಿಂದ ಅತಿಗೆಂಪು ಬೆಳಕಿನಲ್ಲಿ ಆಕಾಶ ನೋಡುತ್ತದೆ. ಅದು ಮೊದಲ ಗ್ಯಾಲಕ್ಸಿಗಳಲ್ಲಿ ಕೆಲವನ್ನು ಕಾಣುತ್ತದೆ.",
  "missionChandrayaan3": "ಭಾರತ ಚಂದ್ರನ ಮೇಲೆ ಸುರಕ್ಷಿತವಾಗಿ ಇಳಿದ ನಾಲ್ಕನೇ ದೇಶವಾಯಿತು, ಮತ್ತು ದಕ್ಷಿಣ ಧ್ರುವದ ಬಳಿ ಇಳಿದ ಮೊದಲ ದೇಶ. ವಿಕ್ರಮ್ ಲ್ಯಾಂಡರ್ ಪ್ರಜ್ಞಾನ್ ರೋವರ್ ಅನ್ನು ಹೊತ್ತೊಯ್ದಿತ್ತು."
}
