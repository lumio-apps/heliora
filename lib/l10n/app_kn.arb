  "qColdestMoon": "ಈ ಚಂದ್ರಗಳಲ್ಲಿ ಅತಿ ತಂಪಾದದ್ದು ಯಾವುದು?",
  "qSecondLargestMoon": "ಈ ಚಂದ್ರಗಳಲ್ಲಿ ಎರಡನೇ ಅತಿ ದೊಡ್ಡದು ಯಾವುದು?",
  "factTitle": "ನಿಮಗೆ ಗೊತ್ತೇ?",
  "factTap": "ಇನ್ನೊಂದು ವಿಷಯ ನೋಡಲು ಟ್ಯಾಪ್ ಮಾಡಿ",
  "factSun1": "ಸೌರವ್ಯೂಹದ ಒಟ್ಟು ದ್ರವ್ಯರಾಶಿಯ 99.8% ಸೂರ್ಯನಲ್ಲಿದೆ.",
  "factSun2": "ಸೂರ್ಯನ ಬೆಳಕು ಭೂಮಿಯನ್ನು ತಲುಪಲು ಸುಮಾರು 8 ನಿಮಿಷ 20 ಸೆಕೆಂಡ್ ತೆಗೆದುಕೊಳ್ಳುತ್ತದೆ.",
  "factMercury1": "ಬುಧದಲ್ಲಿ ಒಂದು ದಿನ, ಅಂದರೆ ಒಂದು ಸೂರ್ಯೋದಯದಿಂದ ಮುಂದಿನ ಸೂರ್ಯೋದಯದವರೆಗೆ, ಸುಮಾರು 176 ಭೂಮಿ-ದಿನಗಳಷ್ಟು. ಅದು ಅದರ ವರ್ಷದ ಎರಡರಷ್ಟು ಉದ್ದ.",
  "factMercury2": "ಬುಧದಲ್ಲಿ ಗಾಳಿ ಬಹುತೇಕ ಇಲ್ಲ, ಆದ್ದರಿಂದ ಹಗಲಿನಲ್ಲೂ ಅದರ ಆಕಾಶ ಕಪ್ಪಾಗಿರುತ್ತದೆ ಮತ್ತು ರಾತ್ರಿಗಳು ಹೆಪ್ಪುಗಟ್ಟುವಷ್ಟು ತಂಪು.",
  "factVenus1": "ಶುಕ್ರ ಹಿಮ್ಮುಖವಾಗಿ ತಿರುಗುತ್ತದೆ, ಆದ್ದರಿಂದ ಅಲ್ಲಿ ಸೂರ್ಯ ಪಶ್ಚಿಮದಲ್ಲಿ ಉದಯಿಸುತ್ತಾನೆ.",
  "factVenus2": "ಸೂರ್ಯನಿಂದ ಹೆಚ್ಚು ದೂರದಲ್ಲಿದ್ದರೂ ಶುಕ್ರ ಬುಧಕ್ಕಿಂತ ಬಿಸಿ, ಏಕೆಂದರೆ ಅದರ ದಟ್ಟ ಗಾಳಿ ಶಾಖವನ್ನು ಹಿಡಿದಿಡುತ್ತದೆ.",
  "factEarth1": "ಜೀವ ಇದೆ ಎಂದು ನಮಗೆ ಗೊತ್ತಿರುವ ಏಕೈಕ ಸ್ಥಳ ಭೂಮಿ, ಮತ್ತು ಅದರ ಮೇಲ್ಮೈಯ ಸುಮಾರು 71% ನೀರಿನಿಂದ ಆವೃತ.",
  "factEarth2": "ಭೂಮಿ ಪರಿಪೂರ್ಣ ಚೆಂಡಲ್ಲ. ತಿರುಗುವುದರಿಂದ ಅದು ಸಮಭಾಜಕ ವೃತ್ತದ ಬಳಿ ಸ್ವಲ್ಪ ಉಬ್ಬಿದೆ.",
  "factMars1": "ಮಂಗಳದ ಒಲಿಂಪಸ್ ಮಾನ್ಸ್ ಸೌರವ್ಯೂಹದ ಅತಿ ಎತ್ತರದ ಜ್ವಾಲಾಮುಖಿ, ಮೌಂಟ್ ಎವರೆಸ್ಟ್‌ಗಿಂತ ಸುಮಾರು ಎರಡೂವರೆ ಪಟ್ಟು ಎತ್ತರ.",
  "factMars2": "ಮಂಗಳದಲ್ಲಿ ಸೂರ್ಯಾಸ್ತ ನೀಲಿಯಾಗಿ ಕಾಣುತ್ತದೆ.",
  "factJupiter1": "ಗುರುವಿನ ದ್ರವ್ಯರಾಶಿ ಉಳಿದ ಎಲ್ಲ ಗ್ರಹಗಳ ಒಟ್ಟು ದ್ರವ್ಯರಾಶಿಯ ಎರಡರಷ್ಟಕ್ಕಿಂತ ಹೆಚ್ಚು.",
  "factJupiter2": "ಗ್ರೇಟ್ ರೆಡ್ ಸ್ಪಾಟ್ ಭೂಮಿಗಿಂತ ದೊಡ್ಡ ಬಿರುಗಾಳಿ, ಅದನ್ನು ಜನರು 150 ವರ್ಷಗಳಿಗಿಂತ ಹೆಚ್ಚು ಕಾಲದಿಂದ ನೋಡುತ್ತಿದ್ದಾರೆ.",
  "factSaturn1": "ಶನಿ ತನ್ನ ಗಾತ್ರಕ್ಕೆ ಎಷ್ಟು ಹಗುರ ಎಂದರೆ ಸಾಕಷ್ಟು ದೊಡ್ಡ ಟಬ್ ಸಿಕ್ಕರೆ ನೀರಿನಲ್ಲಿ ತೇಲುತ್ತದೆ.",
  "factSaturn2": "ಶನಿಯ ಉಂಗುರಗಳು ತುಂಬ ಅಗಲ ಆದರೆ ತುಂಬ ತೆಳು: ಕೆಲವೆಡೆ ಕೇವಲ ಸುಮಾರು ಹತ್ತು ಮೀಟರ್ ದಪ್ಪ.",
  "factUranus1": "ಯುರೇನಸ್ ಪಕ್ಕಕ್ಕೆ ಉರುಳುತ್ತಾ ಸೂರ್ಯನನ್ನು ಸುತ್ತುತ್ತದೆ, ಅದರ ಅಕ್ಷ ಸುಮಾರು 98 ಡಿಗ್ರಿ ಓರೆಯಾಗಿದೆ.",
  "factUranus2": "ಯುರೇನಸ್ ದೂರದರ್ಶಕದಿಂದ ಕಂಡುಹಿಡಿದ ಮೊದಲ ಗ್ರಹ. ವಿಲಿಯಂ ಹರ್ಷಲ್ 1781ರಲ್ಲಿ ಅದನ್ನು ಗುರುತಿಸಿದರು.",
  "factNeptune1": "ನೆಪ್ಚೂನ್‌ನಲ್ಲಿ ಯಾವ ಗ್ರಹಕ್ಕಿಂತಲೂ ವೇಗದ ಗಾಳಿ ಬೀಸುತ್ತದೆ, ಗಂಟೆಗೆ 2,000 ಕಿಮೀಗಿಂತ ಹೆಚ್ಚು.",
  "factNeptune2": "ನೆಪ್ಚೂನ್ ಯಾರೂ ನೋಡುವ ಮೊದಲೇ ಗಣಿತದಿಂದ ಪತ್ತೆಯಾಯಿತು: 1846ರಲ್ಲಿ ಖಗೋಳಶಾಸ್ತ್ರಜ್ಞರು ಅದು ಎಲ್ಲಿರಬೇಕು ಎಂದು ಲೆಕ್ಕ ಹಾಕಿದರು.",
  "factMoon1": "ಚಂದ್ರ ಪ್ರತಿ ವರ್ಷ ಭೂಮಿಯಿಂದ ಸುಮಾರು 3.8 ಸೆಂಟಿಮೀಟರ್ ಇನ್ನಷ್ಟು ದೂರ ಸರಿಯುತ್ತಾನೆ.",
  "factMoon2": "ನಮಗೆ ಚಂದ್ರನ ಒಂದೇ ಬದಿ ಯಾವಾಗಲೂ ಕಾಣುತ್ತದೆ, ಏಕೆಂದರೆ ಭೂಮಿಯನ್ನು ಒಮ್ಮೆ ಸುತ್ತುವಾಗ ಅವನು ಸರಿಯಾಗಿ ಒಮ್ಮೆ ತಿರುಗುತ್ತಾನೆ.",
  "factPluto1": "ಪ್ಲೂಟೊದಲ್ಲಿ ಒಂದು ವರ್ಷ ಸುಮಾರು 248 ಭೂಮಿ-ವರ್ಷಗಳಷ್ಟು.",
  "factPluto2": "ಪ್ಲೂಟೊದಲ್ಲಿ ಹೆಪ್ಪುಗಟ್ಟಿದ ನೈಟ್ರೋಜನ್‌ನ ಹೃದಯಾಕಾರದ ಬೃಹತ್ ಬಯಲು ಇದೆ.",
  "factIo1": "ಅಯೋ ನಮಗೆ ಗೊತ್ತಿರುವ ಅತಿ ಹೆಚ್ಚು ಜ್ವಾಲಾಮುಖಿಗಳಿರುವ ಲೋಕ, ಅಲ್ಲಿ ನೂರಾರು ಸಕ್ರಿಯ ಜ್ವಾಲಾಮುಖಿಗಳಿವೆ.",
  "factIo2": "ಗುರುವಿನ ಗುರುತ್ವ ಅಯೋವನ್ನು ಅದುಮಿ ಎಳೆಯುತ್ತದೆ, ಮತ್ತು ಅದರಿಂದ ಹುಟ್ಟುವ ಶಾಖ ಅದರ ಜ್ವಾಲಾಮುಖಿಗಳಿಗೆ ಶಕ್ತಿ ನೀಡುತ್ತದೆ.",
  "factEuropa1": "ಮಂಜುಗಡ್ಡೆಯ ಕವಚದ ಕೆಳಗೆ ಯುರೋಪಾದಲ್ಲಿ ಬಹುಶಃ ಭೂಮಿಯ ಎಲ್ಲ ಸಾಗರಗಳಿಗಿಂತ ಸುಮಾರು ಎರಡರಷ್ಟು ನೀರಿದೆ.",
  "factEuropa2": "ಭೂಮಿಯಾಚೆ ಜೀವ ಹುಡುಕಲು ಯುರೋಪಾ ಅತ್ಯುತ್ತಮ ಸ್ಥಳಗಳಲ್ಲಿ ಒಂದು. ಯುರೋಪಾ ಕ್ಲಿಪ್ಪರ್ ನೌಕೆ ಅಲ್ಲಿಗೆ ಹೋಗುತ್ತಿದೆ.",
  "factGanymede1": "ಗ್ಯಾನಿಮೀಡ್ ಸೌರವ್ಯೂಹದ ಅತಿ ದೊಡ್ಡ ಚಂದ್ರ. ಅದು ಬುಧಕ್ಕಿಂತಲೂ ದೊಡ್ಡದು.",
  "factGanymede2": "ತನ್ನದೇ ಆದ ಕಾಂತಕ್ಷೇತ್ರ ಇರುವ ಏಕೈಕ ಚಂದ್ರ ಎಂದು ಗ್ಯಾನಿಮೀಡ್ ಗೊತ್ತಾಗಿದೆ.",
  "factCallisto1": "ಕ್ಯಾಲಿಸ್ಟೊ ಸೌರವ್ಯೂಹದ ಅತಿ ಹೆಚ್ಚು ಕುಳಿಗಳಿರುವ ಸ್ಥಳಗಳಲ್ಲಿ ಒಂದು, ಮತ್ತು ಅದರ ಮೇಲ್ಮೈ ತುಂಬ ಹಳೆಯದು.",
  "factCallisto2": "ಕ್ಯಾಲಿಸ್ಟೊ ಗುರುವಿನಿಂದ ಸಾಕಷ್ಟು ದೂರ ಇರುವುದರಿಂದ ಅದರ ಕಠಿಣ ವಿಕಿರಣ ಕಡಿಮೆ ತಗುಲುತ್ತದೆ, ಆದ್ದರಿಂದ ವಿಜ್ಞಾನಿಗಳು ಭವಿಷ್ಯದ ನೆಲೆಗೆ ಅದನ್ನು ಸೂಚಿಸಿದ್ದಾರೆ.",
  "factTitan1": "ಟೈಟಾನ್ ದಟ್ಟ ವಾತಾವರಣ ಇರುವ ಏಕೈಕ ಚಂದ್ರ. ಅದರ ಮೇಲ್ಮೈಯಲ್ಲಿ ಗಾಳಿಯ ಒತ್ತಡ ಭೂಮಿಗಿಂತ ಹೆಚ್ಚು.",
  "factTitan2": "ಟೈಟಾನ್‌ನಲ್ಲಿ ನದಿಗಳು ಮತ್ತು ಸರೋವರಗಳಿವೆ, ಆದರೆ ಅವುಗಳಲ್ಲಿ ನೀರಲ್ಲ, ದ್ರವ ಮೀಥೇನ್ ಮತ್ತು ಈಥೇನ್ ಇದೆ.",
  "factEnceladus1": "ಎನ್ಸೆಲಾಡಸ್ ತನ್ನ ದಕ್ಷಿಣ ಧ್ರುವದ ಬಳಿಯ ಬಿರುಕುಗಳಿಂದ ಮಂಜುಗಡ್ಡೆ ಮತ್ತು ನೀರಿನ ಆವಿಯ ಧಾರೆಗಳನ್ನು ಬಾಹ್ಯಾಕಾಶಕ್ಕೆ ಚಿಮ್ಮುತ್ತದೆ.",
  "factEnceladus2": "ಎನ್ಸೆಲಾಡಸ್‌ನ ಈ ಧಾರೆಗಳು ಶನಿಯ E ಉಂಗುರವನ್ನು ತುಂಬುತ್ತವೆ.",
  "factTriton1": "ಟ್ರೈಟನ್ ನೆಪ್ಚೂನ್ ಅನ್ನು ಹಿಮ್ಮುಖವಾಗಿ ಸುತ್ತುತ್ತದೆ, ಆದ್ದರಿಂದ ಅದು ನೆಪ್ಚೂನ್ ಸೆರೆಹಿಡಿದ ಕುಬ್ಜ ಗ್ರಹ ಆಗಿದ್ದಿರಬಹುದು.",
  "factTriton2": "ಸುಮಾರು −235 °C ನಲ್ಲಿ ಟ್ರೈಟನ್ ಸೌರವ್ಯೂಹದಲ್ಲಿ ತಾಪಮಾನ ಅಳೆದಿರುವ ಅತಿ ತಂಪಾದ ಸ್ಥಳಗಳಲ್ಲಿ ಒಂದು.",
  "jumpInput": "ಭೂಮಿಯ ಮೇಲೆ ನಿಮ್ಮ ಜಿಗಿತದ ಎತ್ತರ (ಸೆಂ.ಮೀ)",
