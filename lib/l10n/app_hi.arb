  "birthdayBillion": "1 अरब सेकंड के",
  "birthdayPassed": "हो चुका",
  "birthdayNote": "यह आपके फ़ोन पर ही Heliora की बाकी चीज़ों जैसी कक्षाओं से निकाला जाता है। आपकी जन्मतिथि फ़ोन से बाहर नहीं जाती।",
  "missionsTitle": "अंतरिक्ष मिशन",
  "missionsSubtitle": "अंतरिक्ष की खोज के मशहूर पल, सबसे पुराने से शुरू।",
  "missionsCardHint": "समय के साथ मशहूर मिशन",
  "missionSputnik1": "पहला कृत्रिम उपग्रह। बीच-बॉल जितनी यह धातु की गेंद करीब तीन महीने पृथ्वी का चक्कर लगाती रही। इसकी बीप रेडियो पर सुनी जा सकती थी, और इसी से अंतरिक्ष युग शुरू हुआ।",
  "missionVostok1": "यूरी गागरिन अंतरिक्ष में जाने वाले पहले इंसान बने। उन्होंने करीब 108 मिनट में पृथ्वी का एक चक्कर लगाया।",
  "missionApollo11": "नील आर्मस्ट्रांग और बज़ एल्ड्रिन शांति सागर में उतरे और चाँद पर चलने वाले पहले इंसान बने। माइकल कॉलिन्स कक्षा में उनका इंतज़ार करते रहे।",
  "missionVenera7": "दूसरे ग्रह पर उतरकर संकेत भेजने वाला पहला यान। उसने शुक्र की कुचल देने वाली गर्मी में करीब 23 मिनट तक डेटा भेजा।",
  "missionViking1": "यह मंगल पर उतरा और छह साल से ज़्यादा काम करता रहा। इसने किसी दूसरे ग्रह की सतह से तस्वीरों और मौसम की रिपोर्टों की पहली लंबी श्रृंखला भेजी।",
  "missionVoyager1": "1977 में छोड़ा गया, यह बृहस्पति और शनि के पास से गुज़रा और 2012 में तारों के बीच की जगह में पहुँचा। यह पृथ्वी से सबसे दूर इंसान की बनाई चीज़ है।",
  "missionHubble": "1990 में छोड़ा गया, यह पृथ्वी की हवा के ऊपर से ब्रह्मांड को देखता है। इसकी साफ़ तस्वीरों से ब्रह्मांड की उम्र नापने में मदद मिली और हज़ारों दूर की आकाशगंगाएँ दिखीं।",
  "missionHuygens": "कैसिनी के साथ गया यान ह्यूजेन्स पैराशूट से शनि के चंद्रमा टाइटन पर उतरा। बाहरी सौरमंडल में यह पहली लैंडिंग थी, और उसने सतह से तस्वीरें भेजीं।",
  "missionCuriosity": "कार जितना बड़ा यह रोवर रॉकेट से चलने वाली ’स्काई क्रेन’ की मदद से गेल क्रेटर में उतरा। इसने पाया कि मंगल पर कभी जीवन के लायक हालात थे।",
  "missionMangalyaan": "भारत का मंगल ऑर्बिटर मिशन पहली ही कोशिश में मंगल की कक्षा में पहुँच गया। किसी भी देश के लिए यह पहली बार था, और वह भी बहुत कम खर्च में।",
  "missionRosetta": "रोसेटा के लैंडर फ़ाइली ने धूमकेतु 67P/चुर्यूमोव–गेरासिमेंको पर उतरकर धूमकेतु पर पहली लैंडिंग की। रोसेटा खुद दो साल तक धूमकेतु का चक्कर लगाता रहा।",
  "missionNewhorizons": "नौ साल के सफ़र के बाद यह प्लूटो के पास से गुज़रा और पहली बार हमें बर्फ़ीले पहाड़ और दिल के आकार का विशाल मैदान दिखाया।",
  "missionPerseverance": "पर्सिवियरेंस रोवर पुराने जीवन के निशान खोजने और चट्टानों के नमूने जमा करने के लिए जेज़ेरो क्रेटर में उतरा। उसके हेलिकॉप्टर इंजेन्युइटी ने किसी दूसरे ग्रह पर पहली संचालित उड़ान भरी।",
  "missionJwst": "सबसे बड़ी अंतरिक्ष दूरबीन में 6.5 मीटर का सुनहरा शीशा है, और वह 15 लाख किमी दूर से इन्फ्रारेड रोशनी में आसमान देखती है। वह कुछ सबसे पहली आकाशगंगाएँ देख पाती है।",
  "missionChandrayaan3": "भारत चाँद पर आराम से उतरने वाला चौथा देश बना, और दक्षिणी ध्रुव के पास उतरने वाला पहला। विक्रम लैंडर अपने साथ प्रज्ञान रोवर लेकर गया था।"
}
