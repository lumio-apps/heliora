  "eclipseTotalLunarDesc": "ಚಂದ್ರ ಸಂಪೂರ್ಣವಾಗಿ ಭೂಮಿಯ ನೆರಳಿನೊಳಗೆ ಹೋಗಿ ಹೆಚ್ಚಾಗಿ ಮಂದ ಕೆಂಪಾಗಿ ಕಾಣುತ್ತದೆ. ಭೂಮಿಯ ರಾತ್ರಿಯ ಬದಿಯಲ್ಲಿರುವ ಎಲ್ಲರೂ ಇದನ್ನು ನೋಡಬಹುದು, ಮತ್ತು ಕಣ್ಣಿನಿಂದ ನೋಡುವುದು ಸುರಕ್ಷಿತ.",
  "eclipsePartialLunarDesc": "ಚಂದ್ರನ ಒಂದು ಭಾಗ (ಅಗಲದ {percent}%) ಭೂಮಿಯ ಗಾಢ ನೆರಳಿನೊಳಗೆ ಹೋಗುತ್ತದೆ. ಕಣ್ಣಿನಿಂದ ನೋಡುವುದು ಸುರಕ್ಷಿತ.",
  "eclipsePenumbralLunarDesc": "ಚಂದ್ರ ಭೂಮಿಯ ಮಸುಕಾದ ಹೊರ ನೆರಳಿನ ಮೂಲಕ ಹಾದುಹೋಗುತ್ತದೆ. ಸ್ವಲ್ಪ ಮಾತ್ರ ಮಂದವಾಗುವುದರಿಂದ ಗಮನಿಸುವುದು ಕಷ್ಟ.",
  "eclipseTotalSolarDesc": "ಭೂಮಿಯ ಮೇಲೆ ಒಂದು ಕಿರಿದಾದ ಪಟ್ಟಿಯಲ್ಲಿ ಚಂದ್ರ ಸೂರ್ಯನನ್ನು ಸಂಪೂರ್ಣವಾಗಿ ಮುಚ್ಚುತ್ತಾನೆ. ಆ ಪಟ್ಟಿಯ ಹೊರಗೆ ಭಾಗಶಃ ಗ್ರಹಣ ಕಾಣುತ್ತದೆ.",
  "eclipseAnnularSolarDesc": "ಚಂದ್ರ ಸ್ವಲ್ಪ ಹೆಚ್ಚು ದೂರದಲ್ಲಿರುವುದರಿಂದ ಸೂರ್ಯನನ್ನು ಪೂರ್ಣ ಮುಚ್ಚಲಾರ, ಹೊಳೆಯುವ ಉಂಗುರ ಉಳಿಯುತ್ತದೆ. ಉಂಗುರ ಕಿರಿದಾದ ಪಟ್ಟಿಯಲ್ಲಿ ಕಾಣುತ್ತದೆ; ಅದರ ಹೊರಗೆ ಗ್ರಹಣ ಭಾಗಶಃ.",
  "eclipseHybridSolarDesc": "ತನ್ನ ಪಟ್ಟಿಯಲ್ಲಿ ಈ ಗ್ರಹಣ ಕೆಲವೆಡೆ ಪೂರ್ಣವಾಗಿಯೂ ಕೆಲವೆಡೆ ಉಂಗುರದಂತೆಯೂ ಕಾಣುತ್ತದೆ. ಪಟ್ಟಿಯ ಹೊರಗೆ ಇದು ಭಾಗಶಃ.",
  "eclipsePartialSolarDesc": "ಚಂದ್ರ ಸೂರ್ಯನ ಒಂದು ಭಾಗವನ್ನು ಮಾತ್ರ ಮುಚ್ಚುತ್ತಾನೆ, ಮತ್ತು ಭೂಮಿಯ ಮೇಲೆ ಎಲ್ಲಿಯೂ ಸೂರ್ಯ ಪೂರ್ಣ ಮುಚ್ಚುವುದಿಲ್ಲ.",
  "eclipseNoCity": "Heliora ದಲ್ಲಿ ಒಂದು ನಗರವನ್ನು ಆರಿಸಿ, ಅಲ್ಲಿಂದ ಇದನ್ನು ನೋಡಬಹುದೇ ಎಂದು ತಿಳಿಯಲು.",
  "eclipseLunarUp": "ಗ್ರಹಣದ ಮಧ್ಯದಲ್ಲಿ {city} ನಲ್ಲಿ ಚಂದ್ರ ದಿಗಂತದ ಮೇಲಿರುತ್ತಾನೆ.",
  "eclipseLunarPartly": "{city} ನಲ್ಲಿ ಚಂದ್ರ ಗ್ರಹಣದ ಸ್ವಲ್ಪ ಭಾಗದಲ್ಲಿ ಮಾತ್ರ ದಿಗಂತದ ಮೇಲಿರುತ್ತಾನೆ.",
  "eclipseLunarDown": "{city} ನಲ್ಲಿ ಚಂದ್ರ ದಿಗಂತದ ಕೆಳಗೇ ಇರುತ್ತಾನೆ, ಹಾಗಾಗಿ ಅಲ್ಲಿಂದ ಕಾಣುವುದಿಲ್ಲ.",
  "eclipseSolarNone": "{city} ನಿಂದ ಕಾಣುವುದಿಲ್ಲ: ಚಂದ್ರನ ನೆರಳು ಅಲ್ಲಿಗೆ ತಲುಪುವುದಿಲ್ಲ, ಅಥವಾ ಸೂರ್ಯ ದಿಗಂತದ ಕೆಳಗಿರುತ್ತಾನೆ.",
  "eclipseSolarSlight": "{city} ನಿಂದ ಹೆಚ್ಚೆಂದರೆ ಬಹಳ ಸಣ್ಣ ಭಾಗಶಃ ಗ್ರಹಣ ಕಾಣುತ್ತದೆ, ಗಮನಿಸುವುದು ಕಷ್ಟ.",
  "eclipseSolarPartial": "{city} ಗಾಗಿ ಸ್ಥೂಲ ಅಂದಾಜು: ಚಂದ್ರ ಹೆಚ್ಚೆಂದರೆ ಸೂರ್ಯನ ಅಗಲದ ಸುಮಾರು {percent}% ಮುಚ್ಚುತ್ತಾನೆ.",
  "eclipseSolarNear": "{city} ಸೂರ್ಯ ಬಹುತೇಕ ಅಥವಾ ಪೂರ್ತಿ ಮುಚ್ಚುವ ಪಟ್ಟಿಯ ಹತ್ತಿರವಿದೆ. ಗ್ರಹಣದ ನಕ್ಷೆ ನೋಡಿ; ಈ ಅಂದಾಜು ಸ್ಥೂಲವಾದದ್ದು.",
  "eclipseSolarSafety": "ಸರಿಯಾದ ಗ್ರಹಣ ಕನ್ನಡಕವಿಲ್ಲದೆ ಎಂದಿಗೂ ಸೂರ್ಯನನ್ನು ನೋಡಬೇಡಿ.",
  "alertsTitle": "ಎಚ್ಚರಿಕೆಗಳು",
  "tonightAlertSwitch": "ಪ್ರತಿ ಸಂಜೆ ಇಂದು ರಾತ್ರಿಯ ಆಕಾಶ",
  "tonightAlertTime": "ಸಮಯ",
  "tonightAlertNote": "ನೀವು ಆರಿಸಿದ ಸಮಯದಲ್ಲಿ ಚಂದ್ರ ಮತ್ತು ಕಾಣುವ ಗ್ರಹಗಳ ಬಗ್ಗೆ ಒಂದು ಚಿಕ್ಕ ಸಂದೇಶ. ಇದು ನಿಮ್ಮ ಫೋನ್‌ನಲ್ಲೇ ಲೆಕ್ಕ ಹಾಕಲ್ಪಡುತ್ತದೆ, ಇಂಟರ್ನೆಟ್ ಬೇಡ. Android Heliora ಗೆ ಮುಂಚಿತವಾಗಿ ಸುಮಾರು ಎರಡು ವಾರಗಳ ಸಂದೇಶಗಳನ್ನು ಮಾತ್ರ ತಯಾರಿಸಲು ಬಿಡುತ್ತದೆ, ಹಾಗಾಗಿ ಆಗಾಗ ಆ್ಯಪ್ ತೆರೆಯಿರಿ.",
  "tonightNotifTitle": "ಇಂದು ರಾತ್ರಿಯ ಆಕಾಶ",
