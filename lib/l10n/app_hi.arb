  "eclipsePenumbralLunarDesc": "चंद्रमा पृथ्वी की हल्की बाहरी छाया से गुज़रता है। वह बस थोड़ा मद्धम होता है, इसलिए पहचानना मुश्किल है।",
  "eclipseTotalSolarDesc": "चंद्रमा पृथ्वी पर एक पतली पट्टी में सूरज को पूरी तरह ढक लेता है। उस पट्टी के बाहर आंशिक ग्रहण दिखता है।",
  "eclipseAnnularSolarDesc": "चंद्रमा थोड़ा ज़्यादा दूर होता है, इसलिए सूरज को पूरा नहीं ढक पाता और चमकदार छल्ला बच जाता है। छल्ला एक पतली पट्टी में दिखता है; उसके बाहर ग्रहण आंशिक होता है।",
  "eclipseHybridSolarDesc": "अपनी पट्टी में यह ग्रहण कुछ जगह पूर्ण और कुछ जगह छल्लेनुमा दिखता है। पट्टी के बाहर यह आंशिक होता है।",
  "eclipsePartialSolarDesc": "चंद्रमा सूरज के सिर्फ़ एक हिस्से को ढकता है, और पृथ्वी पर कहीं भी सूरज पूरा नहीं ढकता।",
  "eclipseNoCity": "Heliora में कोई शहर चुनें, ताकि पता चले कि वहाँ से यह दिखेगा या नहीं।",
  "eclipseLunarUp": "ग्रहण के बीच में {city} में चंद्रमा क्षितिज के ऊपर रहता है।",
  "eclipseLunarPartly": "{city} में चंद्रमा ग्रहण के सिर्फ़ कुछ हिस्से में क्षितिज के ऊपर रहता है।",
  "eclipseLunarDown": "{city} में चंद्रमा क्षितिज के नीचे रहता है, इसलिए वहाँ से यह नहीं दिखेगा।",
  "eclipseSolarNone": "{city} से नहीं दिखेगा: चंद्रमा की छाया वहाँ नहीं पहुँचती, या सूरज क्षितिज के नीचे होता है।",
  "eclipseSolarSlight": "{city} से ज़्यादा से ज़्यादा बहुत हल्का आंशिक ग्रहण दिखेगा, जिसे पहचानना मुश्किल है।",
  "eclipseSolarPartial": "{city} के लिए मोटा अंदाज़ा: चंद्रमा ज़्यादा से ज़्यादा सूरज की चौड़ाई का लगभग {percent}% ढकता है।",
  "eclipseSolarNear": "{city} उस पट्टी के पास है जहाँ सूरज लगभग या पूरी तरह ढक जाता है। ग्रहण का नक्शा देखें; यह अंदाज़ा मोटा है।",
  "eclipseSolarSafety": "सूरज को कभी भी सही ग्रहण-चश्मे के बिना न देखें।",
  "alertsTitle": "अलर्ट",
  "tonightAlertSwitch": "हर शाम आज रात का आसमान",
  "tonightAlertTime": "समय",
  "tonightAlertNote": "आपके चुने समय पर चंद्रमा और दिखने वाले ग्रहों के बारे में एक छोटा सा संदेश। यह आपके फ़ोन पर ही बनता है, इंटरनेट नहीं चाहिए। Android Heliora को सिर्फ़ करीब दो हफ़्ते के संदेश पहले से तैयार करने देता है, इसलिए ऐप बीच-बीच में खोलते रहें।",
