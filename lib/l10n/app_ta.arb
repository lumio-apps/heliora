  "factSun1": "சூரியக் குடும்பத்தின் மொத்த நிறையில் 99.8% சூரியனில் உள்ளது.",
  "factSun2": "சூரிய ஒளி பூமியை அடைய சுமார் 8 நிமிடம் 20 வினாடி ஆகும்.",
  "factMercury1": "புதனில் ஒரு நாள், அதாவது ஒரு சூரிய உதயத்திலிருந்து அடுத்த சூரிய உதயம் வரை, சுமார் 176 பூமி நாட்கள். அது அதன் ஆண்டை விட இரு மடங்கு நீளம்.",
  "factMercury2": "புதனில் காற்று கிட்டத்தட்ட இல்லை, எனவே பகலிலும் அதன் வானம் கருப்பாக இருக்கும், இரவுகள் உறைய வைக்கும் குளிராக இருக்கும்.",
  "factVenus1": "வெள்ளி எதிர்த்திசையில் சுழல்கிறது, எனவே அங்கே சூரியன் மேற்கில் உதிக்கிறது.",
  "factVenus2": "சூரியனிலிருந்து தொலைவில் இருந்தாலும் வெள்ளி புதனை விடச் சூடானது, ஏனெனில் அதன் அடர்ந்த காற்று வெப்பத்தைத் தடுத்து வைக்கிறது.",
  "factEarth1": "உயிர் இருப்பது நமக்குத் தெரிந்த ஒரே இடம் பூமி, அதன் மேற்பரப்பில் சுமார் 71% நீரால் மூடப்பட்டுள்ளது.",
  "factEarth2": "பூமி முழுமையான பந்து அல்ல. சுழல்வதால் அது நடுக்கோட்டுக்கு அருகில் சற்று புடைத்திருக்கிறது.",
  "factMars1": "செவ்வாயின் ஒலிம்பஸ் மான்ஸ் சூரியக் குடும்பத்தின் மிக உயரமான எரிமலை, எவரெஸ்ட் சிகரத்தை விடச் சுமார் இரண்டரை மடங்கு உயரம்.",
  "factMars2": "செவ்வாயில் சூரிய மறைவு நீல நிறத்தில் தெரியும்.",
  "factJupiter1": "வியாழனின் நிறை மற்ற எல்லாக் கிரகங்களின் மொத்த நிறையை விட இரு மடங்குக்கும் அதிகம்.",
  "factJupiter2": "பெரும் சிவப்புப் புள்ளி பூமியை விடப் பெரிய புயல்; மக்கள் அதை 150 ஆண்டுகளுக்கும் மேலாகப் பார்த்து வருகிறார்கள்.",
  "factSaturn1": "சனி தன் அளவுக்கு மிக இலகுவானது; போதுமான பெரிய குளியல் தொட்டி கிடைத்தால் அது நீரில் மிதக்கும்.",
  "factSaturn2": "சனியின் வளையங்கள் மிக அகலமானவை ஆனால் மிக மெல்லியவை: சில இடங்களில் சுமார் பத்து மீட்டர் தடிமன் மட்டுமே.",
  "factUranus1": "யுரேனஸ் பக்கவாட்டில் உருண்டபடி சூரியனைச் சுற்றுகிறது, அதன் அச்சு சுமார் 98 டிகிரி சாய்ந்துள்ளது.",
  "factUranus2": "தொலைநோக்கியால் கண்டுபிடிக்கப்பட்ட முதல் கிரகம் யுரேனஸ். வில்லியம் ஹெர்ஷல் 1781-இல் அதைக் கண்டார்.",
  "factNeptune1": "எந்தக் கிரகத்தையும் விட நெப்டியூனில் காற்று வேகமானது, மணிக்கு 2,000 கி.மீ-க்கும் அதிகம்.",
  "factNeptune2": "யாரும் பார்ப்பதற்கு முன்பே நெப்டியூன் கணிதத்தால் கண்டுபிடிக்கப்பட்டது: 1846-இல் வானியலாளர்கள் அது எங்கே இருக்க வேண்டும் எனக் கணக்கிட்டனர்.",
  "factMoon1": "நிலவு ஒவ்வொரு ஆண்டும் பூமியிலிருந்து சுமார் 3.8 சென்டிமீட்டர் மேலும் விலகிச் செல்கிறது.",
  "factMoon2": "நாம் நிலவின் ஒரே பக்கத்தையே எப்போதும் பார்க்கிறோம், ஏனெனில் பூமியை ஒரு முறை சுற்றும்போது அது சரியாக ஒரு முறை தன்னைத்தானே சுற்றிக்கொள்கிறது.",
  "factPluto1": "புளூட்டோவில் ஒரு ஆண்டு சுமார் 248 பூமி ஆண்டுகள்.",
  "factPluto2": "புளூட்டோவில் உறைந்த நைட்ரஜனால் ஆன இதய வடிவ பெரிய சமவெளி உள்ளது.",
  "factIo1": "நமக்குத் தெரிந்த மிக அதிக எரிமலைகள் உள்ள உலகம் ஐயோ; அங்கே நூற்றுக்கணக்கான செயல்படும் எரிமலைகள் உள்ளன.",
  "factIo2": "வியாழனின் ஈர்ப்பு ஐயோவை அழுத்தி இழுக்கிறது, அதனால் உண்டாகும் வெப்பம் அதன் எரிமலைகளை இயக்குகிறது.",
  "factEuropa1": "பனிக்கட்டி ஓட்டின் கீழே யூரோப்பாவில் பூமியின் எல்லாக் கடல்களையும் விடச் சுமார் இரு மடங்கு நீர் இருக்கலாம்.",
  "factEuropa2": "பூமிக்கு அப்பால் உயிரைத் தேட மிகச் சிறந்த இடங்களில் ஒன்று யூரோப்பா. யூரோப்பா கிளிப்பர் விண்கலம் அங்கே சென்று கொண்டிருக்கிறது.",
  "factGanymede1": "கனிமீடு சூரியக் குடும்பத்தின் மிகப் பெரிய துணைக்கோள். அது புதனை விடவும் பெரியது.",
  "factGanymede2": "தனக்கென சொந்த காந்தப்புலம் உள்ளதாக அறியப்படும் ஒரே துணைக்கோள் கனிமீடு.",
  "factCallisto1": "காலிஸ்டோ சூரியக் குடும்பத்தில் மிக அதிகக் குழிகள் உள்ள இடங்களில் ஒன்று, அதன் மேற்பரப்பு மிகப் பழமையானது.",
  "factCallisto2": "காலிஸ்டோ வியாழனிலிருந்து போதிய தொலைவில் இருப்பதால் அதன் கடுமையான கதிர்வீச்சு குறைவாகவே படுகிறது; எனவே விஞ்ஞானிகள் எதிர்காலத் தளத்துக்கு அதைப் பரிந்துரைத்துள்ளனர்.",
  "factTitan1": "அடர்ந்த வளிமண்டலம் உள்ள ஒரே துணைக்கோள் டைட்டன். அதன் மேற்பரப்பில் காற்றழுத்தம் பூமியை விட அதிகம்.",
  "factTitan2": "டைட்டனில் ஆறுகளும் ஏரிகளும் உள்ளன, ஆனால் அவற்றில் நீர் அல்ல, திரவ மீத்தேனும் ஈத்தேனும் உள்ளன.",
  "factEnceladus1": "என்செலடஸ் தன் தென் துருவத்துக்கு அருகிலுள்ள பிளவுகள் வழியாக பனியும் நீராவியும் கலந்த பீச்சுகளை விண்வெளியில் வீசுகிறது.",
  "factEnceladus2": "என்செலடஸின் இந்தப் பீச்சுகள் சனியின் E வளையத்தை நிரப்புகின்றன.",
  "factTriton1": "ட்ரைட்டன் நெப்டியூனை எதிர்த்திசையில் சுற்றுகிறது, எனவே அது நெப்டியூன் பிடித்துக்கொண்ட குள்ளக் கிரகமாக இருக்கலாம்.",
  "factTriton2": "சுமார் −235 °C வெப்பநிலையில், சூரியக் குடும்பத்தில் வெப்பநிலை அளக்கப்பட்ட மிகக் குளிரான இடங்களில் ட்ரைட்டன் ஒன்று.",
  "jumpInput": "பூமியில் உங்கள் தாவலின் உயரம் (செ.மீ)",
  "jumpHigh": "தாவல்: {height}",
  "jumpFeelsLike": "பூமியில் {height} தாவல் இங்கே ஆகிறது",
  "jumpNote": "உந்துதல் பூமியில் உள்ளதே. சூரியனிலும் வாயுப் பெருங்கிரகங்களிலும் நிற்க நிலமே இல்லை, எனவே இது வெறும் கற்பனை விளையாட்டு.",
  "valueCm": "{value} செ.மீ",
  "valueM": "{value} மீ",
  "eclipseTotalLunar": "முழு சந்திர கிரகணம்",
  "eclipsePartialLunar": "பகுதி சந்திர கிரகணம்",
  "eclipsePenumbralLunar": "புறநிழல் சந்திர கிரகணம்",
  "eclipseTotalSolar": "முழு சூரிய கிரகணம்",
  "eclipseAnnularSolar": "வளைய சூரிய கிரகணம்",
  "eclipseHybridSolar": "கலப்பு சூரிய கிரகணம்",
  "eclipsePartialSolar": "பகுதி சூரிய கிரகணம்",
  "eclipseTotalLunarDesc": "நிலா முழுவதும் பூமியின் நிழலுக்குள் செல்கிறது, அடிக்கடி மங்கிய சிவப்பாகத் தெரியும். பூமியின் இரவுப் பக்கத்தில் உள்ள அனைவரும் இதைப் பார்க்கலாம்; கண்ணால் பார்ப்பது பாதுகாப்பானது.",
  "eclipsePartialLunarDesc": "நிலாவின் ஒரு பகுதி (அகலத்தின் {percent}%) பூமியின் அடர் நிழலுக்குள் செல்கிறது. கண்ணால் பார்ப்பது பாதுகாப்பானது.",
  "eclipsePenumbralLunarDesc": "நிலா பூமியின் மங்கலான வெளிப்புற நிழல் வழியாகச் செல்கிறது. சிறிதளவு மட்டுமே மங்குவதால் கவனிப்பது கடினம்.",
  "eclipseTotalSolarDesc": "பூமியின் மீது ஒரு குறுகிய பாதையில் நிலா சூரியனை முழுவதுமாக மறைக்கிறது. அந்தப் பாதைக்கு வெளியே பகுதி கிரகணம் தெரியும்.",
  "eclipseAnnularSolarDesc": "நிலா சற்றுத் தொலைவில் இருப்பதால் சூரியனை முழுவதும் மறைக்க முடியாது; ஒளிரும் வளையம் மிஞ்சும். வளையம் ஒரு குறுகிய பாதையில் தெரியும்; அதற்கு வெளியே கிரகணம் பகுதியாக இருக்கும்.",
  "eclipseHybridSolarDesc": "தன் பாதையில் இந்த கிரகணம் சில இடங்களில் முழுமையாகவும் சில இடங்களில் வளையமாகவும் தெரியும். பாதைக்கு வெளியே அது பகுதியாக இருக்கும்.",
  "eclipsePartialSolarDesc": "நிலா சூரியனின் ஒரு பகுதியை மட்டுமே மறைக்கிறது; பூமியில் எங்கும் சூரியன் முழுவதும் மறையாது.",
  "eclipseNoCity": "அங்கிருந்து பார்க்க முடியுமா என்று அறிய Heliora-வில் ஒரு நகரத்தைத் தேர்ந்தெடுக்கவும்.",
  "eclipseLunarUp": "கிரகணத்தின் நடுவில் {city}-ல் நிலா அடிவானத்துக்கு மேலே இருக்கும்.",
  "eclipseLunarPartly": "{city}-ல் கிரகணத்தின் ஒரு பகுதியில் மட்டுமே நிலா அடிவானத்துக்கு மேலே இருக்கும்.",
  "eclipseLunarDown": "{city}-ல் நிலா அடிவானத்துக்குக் கீழேயே இருக்கும், அதனால் அங்கிருந்து தெரியாது.",
  "eclipseSolarNone": "{city}-ல் இருந்து தெரியாது: நிலாவின் நிழல் அங்கே விழாது, அல்லது சூரியன் அடிவானத்துக்குக் கீழே இருக்கும்.",
  "eclipseSolarSlight": "{city}-ல் இருந்து அதிகபட்சம் மிகச் சிறிய பகுதி கிரகணம் மட்டுமே, கவனிப்பது கடினம்.",
  "eclipseSolarPartial": "{city}-க்கான தோராய மதிப்பீடு: நிலா அதிகபட்சம் சூரியனின் அகலத்தில் சுமார் {percent}% மறைக்கிறது.",
  "eclipseSolarNear": "சூரியன் கிட்டத்தட்ட அல்லது முழுவதும் மறையும் பாதைக்கு {city} அருகில் உள்ளது. கிரகண வரைபடத்தைப் பாருங்கள்; இந்த மதிப்பீடு தோராயமானது.",
  "eclipseSolarSafety": "சரியான கிரகணக் கண்ணாடி இல்லாமல் சூரியனை ஒருபோதும் பார்க்காதீர்கள்.",
  "alertsTitle": "எச்சரிக்கைகள்",
  "tonightAlertSwitch": "ஒவ்வொரு மாலையும் இன்றிரவு வானம்",
  "tonightAlertTime": "நேரம்",
  "tonightAlertNote": "நீங்கள் தேர்ந்தெடுத்த நேரத்தில் நிலா மற்றும் தெரியும் கோள்கள் பற்றிய ஒரு சிறு செய்தி. இது உங்கள் தொலைபேசியிலேயே கணக்கிடப்படும், இணையம் தேவையில்லை. Android, Heliora-வை முன்கூட்டியே சுமார் இரண்டு வாரச் செய்திகளை மட்டுமே தயாரிக்க அனுமதிக்கிறது, எனவே ஆப்பை அவ்வப்போது திறங்கள்.",
